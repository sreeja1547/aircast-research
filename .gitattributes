# Enforce consistent LF line endings across platforms
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.joblib binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.gz binary
*.pkl binary
